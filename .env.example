# ============================================================
# AI-ToRAG 环境变量样例：复制为 .env 后按需修改。
# 所有 provider 默认 fake —— 不配置任何真实模型服务也能跑通全部测试。
# ============================================================

# ---------------- 应用 ----------------
# 应用名
APP_NAME=ai-torag
# 调试模式（True 时未捕获异常的响应体会带异常类型信息）
DEBUG=false

# ---------------- PostgreSQL（元数据唯一事实源） ----------------
# 连接串（SQLAlchemy 格式，psycopg3 驱动）
DATABASE_URL=postgresql+psycopg://torag:torag@localhost:5432/torag

# ---------------- Redis（任务队列 / 缓存） ----------------
REDIS_URL=redis://localhost:6379/0

# ---------------- Milvus（向量库） ----------------
# Milvus 地址（standalone 默认端口 19530）
MILVUS_URI=http://localhost:19530
# chunk 向量集合名
MILVUS_COLLECTION=torag_chunk

# ---------------- MinIO（原始文件对象存储） ----------------
# endpoint 不带 scheme
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# 原始文件桶名
MINIO_BUCKET=torag-raw
# 是否走 TLS（本地开发为 false）
MINIO_SECURE=false

# ---------------- Embedding（dense + sparse） ----------------
# provider: fake | openai（openai = OpenAI 兼容 HTTP 协议）
EMBED_PROVIDER=fake
# OpenAI 兼容服务地址，如 http://localhost:9997/v1
EMBED_BASE_URL=
EMBED_API_KEY=
# 模型名（BGE-M3 一次产出 dense + sparse）
EMBED_MODEL=bge-m3
# 向量维度（必须与索引一致）
EMBED_DIM=1024

# ---------------- Rerank ----------------
RERANK_PROVIDER=fake
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=bge-reranker-v2-m3

# ---------------- LLM ----------------
LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_API_KEY=
# 主模型（回答生成）
LLM_MODEL=qwen2.5-7b-instruct
# 轻量模型（查询改写等），为空时回退主模型
LLM_SMALL_MODEL=qwen2.5-1.5b-instruct
